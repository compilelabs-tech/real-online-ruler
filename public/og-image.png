<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <rect width="1200" height="630" fill="#0066ff"/>
  <text x="600" y="280" font-family="system-ui, sans-serif" font-size="64" font-weight="bold" fill="white" text-anchor="middle">Real Online Ruler</text>
  <text x="600" y="360" font-family="system-ui, sans-serif" font-size="28" fill="rgba(255,255,255,0.9)" text-anchor="middle">Actual Size On-Screen Ruler</text>
  <text x="600" y="410" font-family="system-ui, sans-serif" font-size="20" fill="rgba(255,255,255,0.8)" text-anchor="middle">cm · mm · inches · Calibrated</text>
  <!-- Ruler icon -->
  <g transform="translate(500, 470)">
    <rect x="0" y="0" width="200" height="20" rx="4" fill="white" opacity="0.3"/>
    <line x1="50" y1="0" x2="50" y2="20" stroke="white" stroke-width="3"/>
    <line x1="100" y1="0" x2="100" y2="20" stroke="white" stroke-width="2"/>
    <line x1="150" y1="0" x2="150" y2="20" stroke="white" stroke-width="3"/>
    <text x="100" y="15" font-family="system-ui, sans-serif" font-size="12" fill="white" text-anchor="middle" dominant-baseline="middle">5 cm</text>
  </g>
</svg>
